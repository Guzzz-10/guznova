    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT subscriber_id, estado\nFROM conversaciones\nWHERE NOT bot_activo\n  AND GREATEST(COALESCE(derivado_at, '-infinity'::timestamptz), COALESCE(tomado_at, '-infinity'::timestamptz))\n      < now() - make_interval(hours => $1::int)\nORDER BY GREATEST(COALESCE(derivado_at, '-infinity'::timestamptz), COALESCE(tomado_at, '-infinity'::timestamptz))\nLIMIT 200;",
        "options": {
          "queryReplacement": "={{ [ $('Configuración inactividad').first().json.HORAS_REACTIVACION_BOT ] }}"
        }
      },
      "id": "daae0b00-55e3-4793-ac23-836e707bf758",
