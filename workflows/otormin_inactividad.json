        "query": "WITH upd AS (\n  UPDATE conversaciones SET\n    bot_activo = true,\n    reactivado_at = now(),\n    estado = CASE WHEN estado = 'necesita_humano' THEN 'en_conversacion' ELSE estado END\n  WHERE subscriber_id = $1\n  RETURNING subscriber_id, estado\n), ev AS (\n  INSERT INTO eventos_conversacion (subscriber_id, tipo, estado, detalle)\n  SELECT subscriber_id, 'reactivacion', estado,\n         jsonb_build_object('automatica', true, 'horas', $2::int, 'ya_estaba_activo_en_manychat', $3::boolean)\n  FROM upd\n  RETURNING id\n)\nSELECT $1::text AS subscriber_id, (SELECT count(*) FROM ev)::int AS registrado;",
        "options": {
          "queryReplacement": "={{ [ $('Preparar reactivación').item.json.subscriber_id, $('Configuración inactividad').first().json.HORAS_REACTIVACION_BOT, !$('Preparar reactivación').item.json.sigue_apagado ] }}"
        }
      },
