    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Para cada bot apagado hace más de X horas: ¿sigue apagado en ManyChat?\nconst fila = $('Buscar bots apagados vencidos').item.json;\nconst info = $json || {};\nconst campos = Array.isArray(info.data?.custom_fields) ? info.data.custom_fields : [];\nconst valor = String(campos.find((c) => c && c.name === 'bot_activo')?.value ?? '').trim().toLowerCase();\nconst sid = String(fila.subscriber_id);\n\nreturn {\n  json: {\n    subscriber_id: sid,\n    subscriber_id_api: /^\\d{1,15}$/.test(sid) ? Number(sid) : sid,\n    estado: fila.estado,\n    // Si ManyChat no respondió (error), no se toca nada en ManyChat\n    manychat_ok: campos.length > 0,\n    sigue_apagado: ['no', 'false', '0', 'off', 'n'].includes(valor),\n    estaba_derivado: fila.estado === 'necesita_humano',\n  },\n};\n"
      },
