    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH upd AS (\n  UPDATE conversaciones SET estado = 'sin_respuesta', sin_respuesta_at = now()\n  WHERE subscriber_id = $1 AND estado = $2\n  RETURNING subscriber_id\n), ev AS (\n  INSERT INTO eventos_conversacion (subscriber_id, tipo, estado, detalle)\n  SELECT subscriber_id, 'sin_respuesta', 'sin_respuesta', jsonb_build_object('desde', $2::text, 'horas', $3::int) FROM upd\n  RETURNING id\n)\nSELECT $1::text AS subscriber_id, (SELECT count(*) FROM ev)::int AS registrado;",
        "options": {
          "queryReplacement": "={{ [ $('Buscar clientes sin respuesta').item.json.subscriber_id, $('Buscar clientes sin respuesta').item.json.estado_anterior, $('Configuración inactividad').first().json.HORAS_SIN_RESPUESTA ] }}"
        }
      },
