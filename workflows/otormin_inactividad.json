      ],
      "notes": "SEGUIMIENTO_ACTIVO = si para mandar la plantilla de seguimiento (flow_ns del flow que empieza con la plantilla).",
      "notesInFlow": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT subscriber_id,\n       estado AS estado_anterior,\n       seguimiento_enviado_at IS NOT NULL AS ya_tuvo_seguimiento\nFROM conversaciones\nWHERE bot_activo\n  AND estado IN ('nuevo', 'en_conversacion', 'lead_caliente')\n  AND ultimo_mensaje_bot_at IS NOT NULL\n  AND ultimo_mensaje_bot_at < now() - make_interval(hours => $1::int)\n  AND (ultimo_mensaje_cliente_at IS NULL OR ultimo_mensaje_cliente_at <= ultimo_mensaje_bot_at)\nORDER BY ultimo_mensaje_bot_at\nLIMIT 200;",
        "options": {
          "queryReplacement": "={{ [ $('Configuración inactividad').first().json.HORAS_SIN_RESPUESTA ] }}"
        }
      },
      "id": "14801603-e72c-4302-ad45-8ffcae20e5cc",
      "name": "Buscar clientes sin respuesta",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        200,
        160
      ],
