        "query": "WITH upd AS (\n  UPDATE conversaciones SET seguimiento_enviado_at = now()\n  WHERE subscriber_id = $1\n  RETURNING subscriber_id\n)\nINSERT INTO eventos_conversacion (subscriber_id, tipo, estado, detalle)\nSELECT subscriber_id, 'seguimiento', 'sin_respuesta', jsonb_build_object('flow_ns', $2::text) FROM upd\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ [ $('Buscar clientes sin respuesta').item.json.subscriber_id, $('Configuración inactividad').first().json.FLOW_SEGUIMIENTO_PLANTILLA ] }}"
