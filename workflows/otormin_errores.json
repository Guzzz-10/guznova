      "id": "446ef667-69c6-4ddc-a9f7-ababe575cd83",
      "name": "Leer la ejecución fallida",
      "type": "n8n-nodes-base.n8n",
      "typeVersion": 1,
      "position": [
        640,
        520
      ],
      "credentials": {
        "n8nApi": {
          "id": "otorminN8nApi",
          "name": "n8n API (errores)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
