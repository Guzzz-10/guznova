    {
      "parameters": {
        "jsCode": "// Arma el aviso para el administrador con los datos del error\nconst e = $('Error en un workflow').first().json;\nconst wf = e.workflow || {};\nconst ex = e.execution || {};\nconst trig = e.trigger || {};\nconst err = ex.error || trig.error || {};\nconst ahora = $now.setZone('America/Montevideo').toFormat('dd/LL/yyyy HH:mm');\nconst detalleError = err.message || err.description || JSON.stringify(err).slice(0, 500);\nconst ultimoNodo = ex.lastNodeExecuted || err.node?.name || trig.node?.name || '';\n\nconst asunto = `Bot Otormín: error en \"${wf.name || 'workflow'}\"`;\nconst texto = [\n  `Se produjo un error en n8n (${ahora}).`,\n  '',\n  `Workflow: ${wf.name || '-'} (id ${wf.id || '-'})`,\n  `Ejecución: ${ex.id || '-'} ${ex.url || ''}`,\n  `Último nodo: ${ultimoNodo || '-'}`,\n  `Error: ${detalleError}`,\n  '',\n  'Si el error fue con un cliente, el bot le manda un mensaje de respaldo y lo deriva a un asesor (tag necesita_humano).',\n].join('\\n');\n\nreturn [{\n  json: {\n    asunto,\n    texto,\n    texto_whatsapp: `⚠️ ${asunto}\\nÚltimo nodo: ${ultimoNodo || '-'}\\nError: ${String(detalleError).slice(0, 300)}`,\n    workflow_nombre: wf.name || '',\n    execution_id: ex.id ? String(ex.id) : '',\n    ultimo_nodo: ultimoNodo,\n    error: String(detalleError).slice(0, 500),\n  },\n}];\n"
      },
