    {
      "parameters": {
        "jsCode": "// Busca en la ejecución fallida a qué cliente había que responderle y decide\n// si corresponde mandarle el mensaje de respaldo (nunca dejarlo sin respuesta).\nconst ex = $input.first().json || {};\nconst aviso = $('Armar aviso').first().json;\n\nlet data = ex.data;\nif (typeof data === 'string') { try { data = JSON.parse(data); } catch (_) { data = null; } }\nconst runData = data?.resultData?.runData || {};\n\nconst corrio = (n) => Array.isArray(runData[n]) && runData[n].length > 0;\nconst salida = (n) => runData[n]?.[0]?.data?.main;\nconst primerItem = (n) => salida(n)?.[0]?.[0]?.json;\n// true si el IF mandó todo por la rama \"false\"\nconst salioPorFalse = (n) => {\n  const m = salida(n);\n  return Array.isArray(m) && !(m[0]?.length) && (m[1]?.length > 0);\n};\n\nconst entrada = primerItem('Normalizar entrada') || {};\nlet motivoSalteo = '';\nif (!entrada.subscriber_id) motivoSalteo = 'no se encontró el contacto en la ejecución';\nelse if (entrada.bot_activo === false) motivoSalteo = 'el bot estaba apagado (lo atiende un humano)';\nelse if (corrio('Disparar flow \"Enviar mensajes\"')) motivoSalteo = 'el cliente ya había recibido la respuesta';\nelse if (salioPorFalse('¿Es un mensaje nuevo?')) motivoSalteo = 'era un mensaje repetido';\nelse if (salioPorFalse('¿Es el último mensaje?')) motivoSalteo = 'otro mensaje del mismo cliente seguía la conversación';\nelse if (salioPorFalse('¿Sigue activo el bot?')) motivoSalteo = 'un humano ya había tomado el chat';\n\nconst sid = String(entrada.subscriber_id || '');\nreturn [{\n  json: {\n    responder: !motivoSalteo,\n    motivo_salteo: motivoSalteo,\n    subscriber_id: sid,\n    subscriber_id_api: /^\\d{1,15}$/.test(sid) ? Number(sid) : sid,\n    ultimo_nodo: aviso.ultimo_nodo,\n    error: aviso.error,\n    execution_id: aviso.execution_id,\n  },\n}];\n"
      },
      "id": "659936d7-6178-4fed-a944-2676f71f6702",
