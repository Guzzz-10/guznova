    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH previo AS (\n  SELECT EXISTS (\n    SELECT 1 FROM eventos_conversacion\n    WHERE subscriber_id = $1 AND tipo = 'error'\n      AND (detalle->>'respaldo_enviado')::boolean\n      AND created_at > now() - interval '10 minutes'\n  ) AS ya_avisado\n), actual AS (\n  SELECT estado FROM conversaciones WHERE subscriber_id = $1\n), ev AS (\n  INSERT INTO eventos_conversacion (subscriber_id, tipo, estado, detalle)\n  SELECT $1, 'error', 'necesita_humano',\n         jsonb_build_object('nodo', $2::text, 'error', $3::text, 'ejecucion', $4::text,\n                            'respaldo_enviado', NOT (SELECT ya_avisado FROM previo))\n  WHERE EXISTS (SELECT 1 FROM actual)\n  RETURNING id\n), upd AS (\n  UPDATE conversaciones SET\n    bot_activo = false, derivado_at = now(), estado = 'necesita_humano',\n    motivo_derivacion = 'Falla técnica del bot: revisar el chat y responder al cliente'\n  WHERE subscriber_id = $1 AND NOT (SELECT ya_avisado FROM previo)\n  RETURNING subscriber_id\n)\nSELECT (SELECT ya_avisado FROM previo) AS ya_avisado,\n       COALESCE((SELECT estado FROM actual), '') AS estado_anterior,\n       (SELECT count(*) FROM ev)::int AS registrado;",
        "options": {
          "queryReplacement": "={{ [ $('Buscar al cliente afectado').first().json.subscriber_id, $('Buscar al cliente afectado').first().json.ultimo_nodo || '', $('Buscar al cliente afectado').first().json.error || '', $('Buscar al cliente afectado').first().json.execution_id || '' ] }}"
        }
      },
