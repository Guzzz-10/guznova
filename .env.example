# =====================================================================
# Otormín - variables de entorno de Docker Compose
# Copiar a .env y completar. NUNCA subir el .env al repositorio.
# Los tokens de ManyChat, OpenAI y Google NO van acá: se cargan como
# credenciales dentro de n8n (ver docs/MANYCHAT_SETUP.md).
# =====================================================================

# Versión de n8n (fijada para que una actualización no rompa el bot)
N8N_VERSION=2.44.4

# Dominio público donde va a responder n8n (sin https://).
# Tiene que apuntar (registro DNS A) a la IP del servidor.
N8N_HOST=bot.otormin.com.uy

# Email para el certificado HTTPS de Let's Encrypt (Caddy)
ACME_EMAIL=admin@otormin.com.uy

# Clave con la que n8n encripta las credenciales guardadas.
# Generar una vez con:  openssl rand -hex 32
# Si se pierde, hay que volver a cargar todas las credenciales.
N8N_ENCRYPTION_KEY=cambiar_por_una_clave_larga_y_aleatoria

# Postgres (un solo servidor, dos bases: n8n y otormin)
POSTGRES_USER=otormin
POSTGRES_PASSWORD=cambiar_password_postgres
N8N_DB_NAME=n8n
OTORMIN_DB_NAME=otormin

# Redis (cola de n8n en la base 0, buffer del bot en la base 1)
REDIS_PASSWORD=cambiar_password_redis

# Ejecuciones simultáneas por worker
N8N_WORKER_CONCURRENCY=10
