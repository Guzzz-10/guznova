# Base de datos. Para PostgreSQL: cambiar provider en prisma/schema.prisma a "postgresql"
# y usar una URL tipo postgresql://usuario:clave@host:5432/autonova
DATABASE_URL="file:./dev.db"

# Clave secreta para firmar la sesión del panel (mínimo 32 caracteres).
# Generar una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="cambiar-esta-clave-por-una-larga-y-aleatoria-de-32+"

# URL pública del sitio (se usa en links de WhatsApp, sitemap y Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Credenciales del admin de demo creadas por el seed
SEED_ADMIN_USER="admin"
SEED_ADMIN_PASSWORD="autonova2024"
