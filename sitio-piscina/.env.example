# ─────────────────────────────────────────────────────────────
#  Copiá este archivo como .env.local y completá los valores.
#  Si dejás vacías las variables de Supabase, el sitio funciona
#  en MODO DEMO (contenido de ejemplo, el carnet se guarda en el
#  navegador y el panel muestra datos ficticios).
# ─────────────────────────────────────────────────────────────

# URL pública del sitio (sin barra final). Se usa para SEO, QR y Mercado Pago.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp del complejo, solo números con código de país (ej: 59899123456)
NEXT_PUBLIC_WHATSAPP=59800000000

# ── Supabase (Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ¡Secreta! Solo se usa en el servidor. Nunca la expongas en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ── Panel de administración ──
# ÚNICO email que puede entrar a /admin (iniciando sesión con Google).
ADMIN_EMAIL=correodueño@gmail.com
# Minutos sin actividad hasta que se cierra la sesión del panel.
NEXT_PUBLIC_ADMIN_INACTIVIDAD_MIN=30

# ── Mercado Pago (Tus integraciones → Credenciales) ──
# Opcional: también se pueden cargar desde el panel → Configuración.
# Access token de producción (APP_USR-...) o de prueba (TEST-...)
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta de la sección Webhooks (para validar la firma x-signature)
MERCADOPAGO_WEBHOOK_SECRET=

# Solo para pruebas: si es "true" y no hay token de Mercado Pago,
# el paso de pago se simula y el socio se activa sin cobrar. ¡Nunca en producción!
PAGOS_SIMULADOS=false
